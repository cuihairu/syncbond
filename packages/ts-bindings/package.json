{
  "name": "@syncbond/bindings-ts",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript bindings for the syncbond Rust core (napi-rs). Private; not published to npm.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "napi build --cwd . --platform --release --output-dir src/native --target-dir \"$PWD/../../target/napi\" --js binding.js --dts binding.d.ts --esm --manifest-path ../../crates/syncbond-napi/Cargo.toml",
    "test": "node --test src/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.10.9",
    "typescript": "^5.7.0"
  }
}
